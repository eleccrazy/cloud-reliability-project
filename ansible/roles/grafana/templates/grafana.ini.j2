# Managed by Ansible

[server]
http_addr = {{ grafana_http_addr }}
http_port = {{ grafana_http_port }}

[security]
admin_user = admin
admin_password = {{ lookup('file', grafana_admin_password_file) | trim }}
disable_gravatar = true

[users]
allow_sign_up = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false
