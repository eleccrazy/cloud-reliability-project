---
apiVersion: 1

prune: true

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    isDefault: true
    url: "http://{{ hostvars[groups['role_prometheus'][0]]['private_ip_address'] }}:9090"
    editable: false
    jsonData:
      httpMethod: POST
      timeInterval: "30s"
