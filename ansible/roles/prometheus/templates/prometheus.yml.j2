# Managed by Ansible

global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: 30s

storage:
  tsdb:
    retention:
      time: {{ prometheus_retention_time }}
      size: {{ prometheus_retention_size }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - "127.0.0.1:9090"

  - job_name: node_exporter
    static_configs:
{% for role in ["application", "prometheus", "grafana"] %}
{% for host in groups["role_" ~ role] %}
      - targets:
          - "{{ hostvars[host]['private_ip_address'] }}:9100"
        labels:
          node_role: "{{ role }}"
          environment: "dev"
{% endfor %}
{% endfor %}
